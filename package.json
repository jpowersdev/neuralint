{
  "name": "neuralint",
  "version": "0.1.0-alpha.4",
  "description": "Fast semantic linting against repository-owned engineering rules, powered by TypeSafe AI's Jev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpowersdev/neuralint.git"
  },
  "bugs": {
    "url": "https://github.com/jpowersdev/neuralint/issues"
  },
  "homepage": "https://github.com/jpowersdev/neuralint#readme",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "bin": {
    "neuralint": "dist/Main.js"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b src",
    "prepack": "pnpm build",
    "benchmark": "tsx benchmark/Run.ts",
    "benchmark:realistic": "tsx benchmark/realistic/Run.ts",
    "benchmark:home-assistant": "tsx benchmark/realistic/Run.ts --suite benchmark/home-assistant",
    "benchmark:scaling": "python benchmark/scaling/run.py",
    "benchmark:scaling:judge": "python benchmark/scaling/judge.py",
    "benchmark:scaling:adjudicate": "python benchmark/scaling/adjudicate.py",
    "benchmark:scaling:report": "python benchmark/scaling/report.py",
    "benchmark:strong-reviewers": "python benchmark/strong-reviewers/run.py",
    "benchmark:strong-reviewers:judge": "python benchmark/strong-reviewers/judge.py",
    "benchmark:strong-reviewers:report": "python benchmark/strong-reviewers/report.py",
    "benchmark:effect-idioms:fixtures": "python benchmark/effect-http-play-idioms/BuildFixtures.py",
    "benchmark:effect-idioms": "python benchmark/effect-http-play-idioms/run.py && python benchmark/effect-http-play-idioms/render.py",
    "benchmark:jev-matrix": "tsx benchmark/jev-matrix/Run.ts",
    "benchmark:remediation": "tsx benchmark/remediation/Run.ts",
    "benchmark:remediation:fixture": "python benchmark/remediation/build_fixture.py",
    "benchmark:remediation:judge": "python benchmark/quality/run.py --fixture benchmark/remediation/fixtures/pilot.json --output benchmark/remediation/results/quality-sol-high.json",
    "benchmark:remediation:report": "python benchmark/remediation/report.py",
    "benchmark:doctor:calibrate": "tsx benchmark/rule-doctor/RunCalibration.ts",
    "benchmark:doctor:explain": "tsx benchmark/rule-doctor/ValidateExplanations.ts",
    "benchmark:effect-idioms-30:build": "python benchmark/effect-idioms-30/BuildCatalog.py && python benchmark/effect-idioms-30/BuildFixtures.py",
    "benchmark:effect-idioms-30": "python benchmark/effect-idioms-30/run.py && python benchmark/effect-idioms-30/run_pr.py && python benchmark/effect-idioms-30/render.py && python benchmark/effect-idioms-30/render_summary.py && python benchmark/effect-idioms-30/render_pr.py",
    "quality:fixture": "tsx benchmark/quality/BuildFixture.ts",
    "quality:fixture:check": "tsx benchmark/quality/BuildFixture.ts --check",
    "quality:judge": "python benchmark/quality/run.py",
    "quality:judge:adversarial": "python benchmark/quality/run.py --mode adversarial",
    "check": "tsc -b && pnpm quality:fixture:check",
    "clean": "tsc -b --clean && rm -rf dist dist-test",
    "dev": "node --import tsx src/Main.ts",
    "start": "node dist/Main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@jpowersdev/effect-pi": "0.1.0",
    "@effect/ai-typesafe": "4.0.0-rc.116",
    "@effect/platform-node": "4.0.0-rc.116",
    "@effect/platform-node-shared": "4.0.0-rc.116",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "effect": "4.0.0-rc.116",
    "minimatch": "10.2.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@types/node": "26.4.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "keywords": [],
  "author": ""
}
